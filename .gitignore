crash.log
crash.*.log
crash.tf.json

# Local overrides
override.tf
override.tf.json
*_override.tf
*_override.tf.json
backend.tf
!backend.tf.example

# Variables & Secrets (.tfvars)
*.tfvars
**/*.tfvars
*.tfvars.json
*.example.tfvars

